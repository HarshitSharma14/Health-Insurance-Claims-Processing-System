# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Gemini API key — free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Anthropic API key (optional — only needed if switching back to Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Policy file path (defaults to policy_terms.json in repo root)
POLICY_FILE_PATH=policy_terms.json

# LLM model to use for extraction
EXTRACTION_MODEL=gemini-1.5-flash
CLASSIFICATION_MODEL=gemini-1.5-flash

# LLM call settings
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# Confidence threshold below which Decision Agent forces MANUAL_REVIEW
MANUAL_REVIEW_CONFIDENCE_THRESHOLD=0.60

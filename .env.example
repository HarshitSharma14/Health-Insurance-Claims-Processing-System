# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Anthropic API key — get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Policy file path (defaults to policy_terms.json in repo root)
POLICY_FILE_PATH=policy_terms.json

# Confidence threshold below which the Decision Agent forces MANUAL_REVIEW.
# Documented assumption — see docs/assumptions.md.
MANUAL_REVIEW_CONFIDENCE_THRESHOLD=0.60

# LLM model to use for extraction / fuzzy matching
EXTRACTION_MODEL=claude-sonnet-4-5
CLASSIFICATION_MODEL=claude-haiku-4-5

# LLM call settings
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
